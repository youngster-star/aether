#!/usr/bin/env bash
# Aether 测试门禁（git 原生 pre-push 兜底 hook）
#
# 拦截场景：在终端手动敲 git push 时（Claude Code 内由 .claude/hooks/pre-push-gate.js 拦截）
# 逻辑与 Claude 侧 hook 一致：
#   1. 纯文档改动（md/txt/gitignore）→ 放行
#   2. 推送含代码变更但无 Stage.md → 阻止（文档同步门禁：进度必须随代码入库）
#   3. .claude/.test-pass.json 有效（HEAD 匹配 + 24h 内）→ 放行
#   4. 否则阻止（git push --no-verify 由 git 自身处理跳过本 hook）
#
# stdin：每行 "<local ref> <local sha> <remote ref> <remote sha>"
# 注意：git 只向 pre-push 喂数据一次，先缓存到临时文件再遍历
# 初始化：bash scripts/setup-hooks.sh（git config core.hooksPath .githooks）

set -u

PASS_FILE=".claude/.test-pass.json"
DOCS_ONLY=1
STAGE_UPDATED=0

# git 仅喂数据一次：stdin 先落临时文件，后续统一从文件遍历
STDIN_CACHE=$(mktemp)
cat > "$STDIN_CACHE"

# 汇总本次推送所有 ref 的改动文件：
# - 判定是否纯文档改动（md/txt）
# - 判定是否包含 Stage.md（代码变更时的文档同步门禁）
while read -r local_ref local_sha remote_ref remote_sha; do
  [ -z "$local_ref" ] && continue
  # 删除分支（local_sha 全 0）：无新增代码，跳过
  [ "$local_sha" = "0000000000000000000000000000000000000000" ] && continue
  if [ "$remote_sha" = "0000000000000000000000000000000000000000" ]; then
    # 远程分支不存在（首次推送）：取该提交可达历史全部文件
    # （git log 全量，避免 diff-tree 只看末次提交导致多提交首次推送绕过门禁）
    FILES=$(git log --format= --name-only "$local_sha" 2>/dev/null || echo "")
  else
    FILES=$(git diff --name-only "$remote_sha".."$local_sha" 2>/dev/null || echo "")
  fi
  if [ -z "$FILES" ]; then
    # 改动内容无法判定：保守处理，不算纯文档（要求测试标记）
    DOCS_ONLY=0
    continue
  fi
  while IFS= read -r f; do
    [ -z "$f" ] && continue
    if [ "$f" = "Stage.md" ]; then
      STAGE_UPDATED=1
    fi
    case "$f" in
      *.md | *.txt | *.gitignore) ;;
      *) DOCS_ONLY=0 ;;
    esac
  done <<< "$FILES"
done < "$STDIN_CACHE"
rm -f "$STDIN_CACHE"

# 1. 纯文档改动放行
if [ "$DOCS_ONLY" = "1" ]; then
  exit 0
fi

# 2. 文档同步门禁：推送含代码变更时，必须伴随 Stage.md 更新
#    （Stage.md §1.4 提交记录表 + 当前阶段进度 + 遗留问题，CLAUDE.md 测试门禁第 5 条）
if [ "$STAGE_UPDATED" = "0" ]; then
  echo ""
  echo "=============================================================="
  echo " Aether 文档同步门禁：push 被阻止"
  echo " 原因：push 含代码变更时必须先更新 Stage.md"
  echo "       （§1.4 提交记录表 + 当前阶段进度 + 遗留问题）"
  echo " 处理：更新 Stage.md 并提交后再推送"
  echo " 紧急跳过：git push --no-verify（需向开发负责人说明）"
  echo "=============================================================="
  echo ""
  exit 1
fi

# 3. 检查测试通过标记
if [ -f "$PASS_FILE" ]; then
  HEAD=$(git rev-parse HEAD)
  PASS_HEAD=$(sed -n 's/.*"head"[[:space:]]*:[[:space:]]*"\([a-f0-9]*\)".*/\1/p' "$PASS_FILE")
  PASS_TS=$(sed -n 's/.*"timestamp"[[:space:]]*:[[:space:]]*\([0-9]*\).*/\1/p' "$PASS_FILE")
  NOW_MS=$(date +%s%3N 2>/dev/null || echo $(( $(date +%s) * 1000 )))
  if [ "$PASS_HEAD" = "$HEAD" ] && [ -n "$PASS_TS" ] && [ $(( NOW_MS - PASS_TS )) -lt 86400000 ]; then
    exit 0
  fi
fi

echo ""
echo "=============================================================="
echo " Aether 测试门禁：push 被阻止"
echo " 原因：测试通过标记缺失或失效（HEAD 不匹配 / 超过 24 小时）"
echo " 处理：在 Claude Code 中运行 /test，全部维度通过后重试"
echo " 紧急跳过：git push --no-verify（需向开发负责人说明）"
echo "=============================================================="
echo ""
exit 1
